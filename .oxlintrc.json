{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": "error",
    "no-undef": "error"
  },
  "env": {
    "builtin": true,
    "browser": true
  }
}